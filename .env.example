# MongoDB Connection
MONGODB_URI=mongodb:+srv://your_username:your_password@your_cluster.mongodb.net/?appName=yourAppName

# Redis Connection (for BullMQ)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_RAW=videos-raw-upload
R2_BUCKET_TRANSCODED=videos-transcoded-data
R2_BUCKET_THUMBNAILS=videos-thumbnails
R2_PUBLIC_URL=https://your-public-url.com
R2_PUBLIC_URL_THUMBNAILS=https://your-thumbnails-public-url.com

# FFmpeg Paths (optional - leave empty to use system FFmpeg)
FFMPEG_PATH=
FFPROBE_PATH=

# Worker scaling (optional)
# By default, concurrency is auto-calculated from available CPU per replica.
# WORKER_CONCURRENCY=2
# USER_WORKER_CONCURRENCY=2
# CREATOR_WORKER_CONCURRENCY=1
# CPU_UTILIZATION_TARGET=0.8
# RESERVED_CPU_CORES=1

# Replica-aware tuning hints (optional)
# REPLICA_COUNT=4

# Global transcode cap across ALL replicas (optional but recommended for predictable load)
# If unset, each replica only enforces its local CPU-based concurrency.
# GLOBAL_MAX_TRANSCODE_JOBS=16
# GLOBAL_TRANSCODE_SEMAPHORE_KEY=videomanch:transcode:global:slots
# GLOBAL_SLOT_LEASE_MS=180000
# GLOBAL_SLOT_WAIT_TIMEOUT_MS=300000
# GLOBAL_SLOT_WAIT_POLL_MS=2000
