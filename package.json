{
    "name": "videomanch-transcoding-engine",
    "version": "1.0.0",
    "description": "Standalone video transcoding engine with BullMQ worker",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch --clear-screen=false src/index.ts",
        "dev:live": "ENABLE_LIVE_WORKER=true tsx watch --clear-screen=false src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "start:live": "ENABLE_LIVE_WORKER=true node dist/index.js",
        "worker": "tsx --clear-screen=false src/index.ts"
    },
    "keywords": [
        "video",
        "transcoding",
        "ffmpeg",
        "bullmq",
        "worker"
    ],
    "dependencies": {
        "@aws-sdk/client-s3": "^3.500.0",
        "@aws-sdk/s3-request-presigner": "^3.500.0",
        "axios": "^1.6.5",
        "bullmq": "^5.1.0",
        "chokidar": "^3.5.3",
        "dotenv": "^16.3.1",
        "fluent-ffmpeg": "^2.1.2",
        "ioredis": "^5.3.2",
        "mongoose": "^8.1.0",
        "node-media-server": "^2.6.2"
    },
    "devDependencies": {
        "@types/fluent-ffmpeg": "^2.1.24",
        "@types/node": "^20.11.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    }
}